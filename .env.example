# Required server-side application origin. Use your HTTPS origin when deployed.
APP_URL=http://localhost:3000
# Local development only; matches compose.yaml. Percent-encode URL credentials.
DATABASE_URL=postgresql://worksphere:worksphere_local@localhost:54329/worksphere?schema=public
# Optional local cache. The app falls back to PostgreSQL when Redis is unavailable.
REDIS_URL=redis://localhost:6379
# Set to true to force PostgreSQL and in-process rate-limit fallbacks.
REDIS_DISABLED=false
# Local/test-only token preview for exercising email-based auth flows. Never enable in production.
EMAIL_DELIVERY_PREVIEW=false
# Public Socket.IO gateway origin and its local listen port.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
REALTIME_PORT=3001
# Development webhook signing secret; replace in every deployed environment.
BILLING_WEBHOOK_SECRET=local_only_replace_with_a_random_32_byte_secret
# Built-in local provider keeps checkout/portal demos self-contained. Replace
# this adapter with a hosted provider implementation before charging customers.
BILLING_PROVIDER=local
# Next.js sets NODE_ENV automatically; do not override it here.
