generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String       @unique @db.VarChar(254)
  name            String       @db.VarChar(100)
  emailVerifiedAt DateTime?    @db.Timestamptz(3)
  passwordHash    String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  authTokens      AuthToken[]
  sentInvitations Invitation[] @relation("InvitationInviter")
  teamMemberships TeamMembership[]
  ownedProjects Project[]
  projectMemberships ProjectMember[]
  activityEvents ActivityEvent[]
}

model AuthToken {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @db.VarChar(64)
  expiresAt  DateTime      @db.Timestamptz(3)
  consumedAt DateTime?     @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Account {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  provider          String   @db.VarChar(100)
  providerAccountId String   @db.VarChar(255)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(100)
  slug        String       @unique @db.VarChar(63)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  invitations  Invitation[]
  teams        Team[]
  projects     Project[]
}

model Membership {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @db.Uuid
  organizationId String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  inviterId      String           @db.Uuid
  email          String           @db.VarChar(254)
  role           MembershipRole   @default(MEMBER)
  tokenHash      String           @unique @db.VarChar(64)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @db.Timestamptz(3)
  acceptedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model Team {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  name           String           @db.VarChar(100)
  slug           String           @db.VarChar(63)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    TeamMembership[]
  projects       Project[]
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model TeamMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  teamId         String?       @db.Uuid
  ownerId        String        @db.Uuid
  name           String        @db.VarChar(120)
  slug           String        @db.VarChar(63)
  description    String?       @db.VarChar(1000)
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members        ProjectMember[]
  events         ActivityEvent[]
  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([teamId])
}

model ProjectMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
  @@index([userId])
}

model ActivityEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  actorId   String   @db.Uuid
  action    String   @db.VarChar(80)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([projectId, createdAt])
}
